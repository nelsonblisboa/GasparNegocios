# =============================================================
# GASPAR — Negócios JPA · Template de credenciais Supabase
# =============================================================
# Copie este arquivo para `.env` e preencha com seus valores:
#     cp .env.example .env
#
# O `.env` é o arquivo que o código lê. O `.env.example`
# é só um modelo (sem segredos) que vai pro git.
# =============================================================

# URL do projeto Supabase (Settings → API → Project URL)
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública (publishable) — equivalente à antiga "anon key"
# (Settings → API → Project API keys → "publishable")
# Esta chave é segura para ser exposta no código do cliente,
# desde que a RLS esteja habilitada na tabela.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
